# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---- 运行数据（上传原件、渲染缓存、数据库）----
data/uploads/
data/renders/
data/*.db
data/*.db-wal
data/*.db-shm

# 迁移前自动备份（一次性，不随仓库走）
data/*.db.bak-*
# 后端/前端运行日志
data/*.log
# OCR 逐页结果缓存（重跑代价高，仅本地保留）
data/ocr_cache/
# bge-m3 向量缓存（同上）
data/embed_cache/
# 生成的评标报告产物
data/reports/
# 样例招标/投标件（可由 scripts/generate_sample_*.py 重建）
data/samples/
# 诊断产物（含真实投标/招标上传件 + SQLite/OCR 缓存，2026-10-30 审查 P2：106M 实盘件防误提交）
data/diag/
# LLM 结果磁盘缓存（模型对投标内容的输出衍生文本，含敏感语料）
data/llm_cache/

# ---- 前端 ----
frontend/node_modules/
frontend/dist/
# tsc 增量构建产物
frontend/tsconfig.tsbuildinfo

# ---- 本地环境 ----
.env
.env.local
# env 备份（含 LLM 密钥，勿提交）
.env.bak*
